{
  "name": "handoff-protocol",
  "version": "3.0.1",
  "description": "Cross-agent context handoff protocol for AI coding agents",
  "keywords": [
    "ai",
    "agent",
    "handoff",
    "context",
    "protocol",
    "opencode",
    "claude",
    "codex"
  ],
  "author": "Handoff Protocol Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HughesCuit/handoff-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/HughesCuit/handoff-protocol/issues"
  },
  "homepage": "https://github.com/HughesCuit/handoff-protocol#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "assets",
    "docs",
    "!docs/superpowers",
    "!docs/superpowers/**",
    "examples",
    "references",
    "scripts",
    "tests",
    "viewer",
    "!viewer/node_modules",
    "!viewer/node_modules/**",
    "!tests/fixtures",
    "install.sh",
    "install-codex.sh",
    "uninstall.sh",
    "SKILL.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "viewer:build": "node viewer/scripts/build.mjs",
    "pretest": "npm run viewer:build",
    "test": "node --test \"tests/node/**/*.test.mjs\" \"viewer/tests/**/*.test.mjs\"",
    "test:deno": "deno test --allow-read --allow-write --allow-run --allow-env tests/deno/",
    "test:skills": "node scripts/verify-skills-discovery.mjs",
    "evaluate:v3-migration": "node scripts/evaluate-v3-migration.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1"
  }
}
